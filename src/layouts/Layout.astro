---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

export interface Props {
  title: string;
}

const { title }: Props = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />    
  </head>
  <header class="border-b border-gray-200 py-4">
    <div id="logo-wrapper">
      <span class="font-display text-primary text-5xl md:text-6xl"><a href="/">Roll&Roll</a>  </span>
    </div>
  </header>
  <body>
    <main class="container grow py-8"><slot /></main>
  </body>
  <footer class="border-t border-gray-200">
    <div id="footer-wrapper"><a href="/about">About Roll&Roll</a></div>
  </footer>
  </html>

